<?xml version="1.0" encoding="UTF-8"?>
<robot name="trunk_robot">
    <group name="trunk_group">
        <chain base_link="trunk_base_link" tip_link="trunk_link4"/>
    </group>

    <group_state name="home" group="trunk_group">
        <joint name="trunk_joint1" value="0"/>
        <joint name="trunk_joint2" value="0"/>
        <joint name="trunk_joint3" value="0"/>
        <joint name="trunk_joint4" value="0"/>
    </group_state>

    <virtual_joint name="virtual_joints" type="fixed" parent_frame="world" child_link="chassis_base_link"/>

    <disable_collisions link1="chassis_base_link" link2="trunk_base_link" reason="Adjacent"/>
    <disable_collisions link1="chassis_base_link" link2="trunk_link1" reason="Never"/>
    <disable_collisions link1="trunk_base_link" link2="trunk_link1" reason="Adjacent"/>
    <disable_collisions link1="trunk_base_link" link2="trunk_link2" reason="Never"/>
    <disable_collisions link1="trunk_base_link" link2="trunk_link3" reason="Never"/>
    <disable_collisions link1="trunk_link1" link2="trunk_link2" reason="Adjacent"/>
    <disable_collisions link1="trunk_link1" link2="trunk_link3" reason="Never"/>
    <disable_collisions link1="trunk_link1" link2="trunk_link4" reason="Never"/>
    <disable_collisions link1="trunk_link2" link2="trunk_link3" reason="Adjacent"/>
    <disable_collisions link1="trunk_link2" link2="trunk_link4" reason="Never"/>
    <disable_collisions link1="trunk_link3" link2="trunk_link4" reason="Adjacent"/>
</robot>
